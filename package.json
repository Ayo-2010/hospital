    "@vue/devtools-api": "^8.2.1",
    "@vue/server-renderer": "^3.5.43",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.0",
    "destr": "^2.0.5",
    "h3": "^1.13.0",
    "nostics": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "nuxt": "^4.5.2",
    "prisma": "^6.8.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  }
